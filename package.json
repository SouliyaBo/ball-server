{
  "name": "football-results-app",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node test-extractor.js",
    "setup:ubuntu": "chmod +x ubuntu-setup.sh && ./ubuntu-setup.sh",
    "pm2:start": "pm2 start server.js --name football-api",
    "pm2:stop": "pm2 stop football-api",
    "pm2:restart": "pm2 restart football-api",
    "pm2:logs": "pm2 logs football-api"
  },
  "keywords": [
    "football",
    "soccer",
    "api",
    "puppeteer",
    "scraping",
    "nodejs",
    "express",
    "ubuntu",
    "linux"
  ],
  "author": "SouliyaBo",
  "license": "ISC",
  "description": "Real-time Football Data API Server - รองรับทั้ง macOS และ Ubuntu",
  "dependencies": {
    "axios": "^1.12.2",
    "express": "^5.1.0",
    "form-data": "^4.0.4",
    "node-cron": "^4.2.1",
    "node-fetch": "^2.6.7",
    "puppeteer": "^24.22.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "pm2": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "darwin",
    "linux"
  ]
