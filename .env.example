# Football API Server Environment Configuration
# คัดลอกไฟล์นี้เป็น .env และแก้ไขค่าตามต้องการ

# =================================
# SERVER CONFIGURATION
# =================================
NODE_ENV=production
PORT=3001

# =================================
# PUPPETEER CONFIGURATION
# =================================
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage,--disable-gpu

# =================================
# API CONFIGURATION
# =================================
API_CACHE_DURATION=120000  # 2 minutes in milliseconds
API_TIMEOUT=30000          # 30 seconds timeout

# =================================
# SECURITY
# =================================
# เปลี่ยน password นี้ให้ปลอดภัย!
REDIS_PASSWORD=footballapi_change_this_password_123

# =================================
# DOMAIN CONFIGURATION
# =================================
# เปลี่ยนเป็น domain ของคุณ
DOMAIN=your-domain.com
EMAIL=your-email@domain.com  # สำหรับ SSL certificate

# =================================
# LOGGING
# =================================
LOG_LEVEL=info

# =================================
# MONITORING (Optional)
# =================================
ENABLE_MONITORING=true
MONITOR_INTERVAL=300  # 5 minutes

# =================================
# SSL CONFIGURATION (Optional)
# =================================
SSL_ENABLED=false
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
